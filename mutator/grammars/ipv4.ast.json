{
  "start": "ipv4_input",
  "recursive_symbols": [],
  "rules": {
    "ipv4_input": "<ipv4> | <ipv4> \"/\" <prefix4> | <ipv4_glob> | <ipv4_last_octet_range> | <ipv4_full_range> | <ipv4_bracket_range>",
    "ipv4": "<octet> \".\" <octet> \".\" <octet> \".\" <octet>",
    "ipv4_glob": "<octet> \".\" <octet> \".\" <octet> \".*\"",
    "ipv4_last_octet_range": "<octet> \".\" <octet> \".\" <octet> \".\" <octet> \"-\" <octet>",
    "ipv4_full_range": "<ipv4> \"-\" <ipv4>",
    "ipv4_bracket_range": "<octet> \".\" <octet> \".\" <octet> \".[\" <digit> \"-\" <digit> \"]\" | <octet> \".\" <octet> \".\" <octet> \".\" <digit> \"[\" <digit> \"-\" <digit> \"]\" | <octet> \".\" <octet> \".\" <octet> \".[\" <digit> <digit> \"]\"",
    "octet": "<number_range min=0 max=255>",
    "prefix4": "<number_range min=0 max=32>",
    "digit": "<number_range min=0 max=9>"
  }
}
